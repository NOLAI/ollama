+bool socket_t::impl::send_data_more(const void * data, size_t size) {
+#ifdef GGML_RPC_RDMA_APPLE
+    if (use_rdma) {
+        return rdma->send(data, size);
+    }
+#elif defined(GGML_RPC_RDMA)
+    if (use_rdma) {
+        return rdma_send(data, size);
+    }
+#endif
+#if defined(MSG_MORE)
+    size_t bytes_sent = 0;
+    while (bytes_sent < size) {
+        size_t size_to_send = std::min(size - bytes_sent, MAX_CHUNK_SIZE);
+        ssize_t n = send(fd, (const char *)data + bytes_sent, size_to_send, MSG_MORE);
+        if (n < 0) {
+            GGML_LOG_ERROR("send (MSG_MORE) failed (bytes_sent=%zu, size_to_send=%zu)\n",
+                           bytes_sent, size_to_send);
+            return false;
+        }
+        bytes_sent += (size_t)n;
+    }
+    return true;
+#else
+    return send_data(data, size);
+#endif
+}
